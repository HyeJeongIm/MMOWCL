{
  "dataset": "mmea-tsn",
  "modality": ["RGB", "Gyro", "Acce"],
  "model_name": "cmr_mfn_r",
  
  "backbone": "tsn",
  "arch": "ViT",
  "fusion_type": "attention",
  
  "train_list": "mydataset_train.txt",
  "test_list": "mydataset_test.txt",
  "mpu_path": "./datasets/UESTC-MMEA-CL/mpu/",
  
  "num_segments": 8,
  "batch_size": 8,
  "workers": 4,
  "dropout": 0.5,
  
  "lr": 0.001,
  "lr_steps": [10, 20],
  "momentum": 0.9,
  "weight_decay": 0.0005,
  "epochs": 50, 
  "clip_gradient": 20,
  
  "memory_size": 320,
  "increment": 8,
  "shuffle": false,
  
  "partialbn": false,
  "freeze": true,
  
  "enable_ood": true,
  "ood_methods": ["MSP", "ODIN", "Energy"],
  
  "seed": 1993,
  "device": [1],
  "prefix": "mmea-owcl",
  "log_test_acc": false
}